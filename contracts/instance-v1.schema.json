{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MIERAI/docs-platform/contracts/instance-v1.schema.json",
  "title": "docs-platform/instance/v1",
  "description": "Per-installation settings, kept outside every repository (YAML or JSON): which provider and model answer each task, budgets, where credentials live, how inspected content is classified, and the thresholds that decide when a provider replaces another. A repository's .docsp.yaml can never select a model.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {
          "$ref": "#/$defs/task",
          "description": "Does this evidence / change contradict this doc section? (yes/no/unknown + verbatim quote)"
        },
        "draft": {
          "$ref": "#/$defs/task",
          "description": "Propose a doc edit; only after the judge said yes; a human reviews it."
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/class"
        },
        "repos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/class"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "glob",
              "class"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "glob": {
                "type": "string"
              },
              "class": {
                "$ref": "#/$defs/class"
              }
            }
          }
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_precision": {
              "type": "number"
            },
            "min_recall": {
              "type": "number"
            },
            "max_unknown_rate": {
              "type": "number"
            },
            "max_quote_rejection_rate": {
              "type": "number"
            },
            "max_usd_per_item": {
              "type": "number"
            },
            "max_p50_latency_ms": {
              "type": "integer"
            }
          }
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_supported_rate": {
              "type": "number"
            },
            "min_similarity": {
              "type": "number"
            },
            "max_usd_per_item": {
              "type": "number"
            },
            "max_p50_latency_ms": {
              "type": "integer"
            }
          }
        }
      }
    },
    "prices": {
      "type": "object",
      "description": "USD per million tokens by model id; overrides the built-in list prices used for estimates.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "number"
          },
          "output": {
            "type": "number"
          },
          "cache_read": {
            "type": "number"
          }
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "description": "Continuous-consistency policy (docs/design.md §12): freshness / cycle counting, ABC classes, per-run budget, SLO.",
      "properties": {
        "max_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "churn_commits": {
          "type": "integer",
          "minimum": 0
        },
        "churn_lines": {
          "type": "integer",
          "minimum": 0
        },
        "run_interval_days": {
          "type": "integer",
          "minimum": 0
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "max_age_days"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "max_age_days": {
                "type": "integer",
                "minimum": 1
              },
              "docs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "min_commits_90d": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_claims": {
              "type": "integer",
              "minimum": 0
            },
            "max_usd": {
              "type": "number",
              "minimum": 0
            },
            "usd_per_claim": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accuracy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "freshness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "phantom_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "batch_days": {
          "type": "integer",
          "minimum": 0,
          "description": "outdated_wording / incomplete_list findings are reported in batches this many days apart (default 7); contradicted / dangling_reference immediately"
        },
        "recommend_after": {
          "type": "integer",
          "minimum": 0,
          "description": "fix drafts of one document within 90 days after which it is recommended to generate it or link instead (default 3)"
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reason",
              "expires"
            ],
            "additionalProperties": false,
            "properties": {
              "claim": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "document path glob"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "expires": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Repository groups (docs/design.md §12.4): documentation in one repository checked against code in others, at the revisions each doc set declares.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "repos"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "role"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "code",
                    "docs",
                    "api-spec",
                    "db-migration",
                    "infra"
                  ]
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "doc_sets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "repo",
                "docs"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "repo": {
                  "type": "string"
                },
                "docs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "repo",
                      "ref"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "repo": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      }
                    }
                  }
                },
                "generated": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "docs"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "docs": {
                        "type": "string"
                      },
                      "input": {
                        "type": "string"
                      }
                    }
                  }
                },
                "contract": {
                  "type": "object",
                  "description": "the doc set is a design-first specification: docsp contract diffs its interface surface against the code at the first target (contract/v1)",
                  "required": [
                    "design_adapter",
                    "code_adapter"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "design_adapter": {
                      "type": "string",
                      "enum": [
                        "factory-design",
                        "openapi-graphql"
                      ]
                    },
                    "code_adapter": {
                      "type": "string",
                      "enum": [
                        "factory-code",
                        "kotlin-graphql"
                      ]
                    },
                    "design_ref": {
                      "type": "string"
                    },
                    "code_paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "authority": {
                      "type": "string",
                      "enum": [
                        "design",
                        "code",
                        "ask"
                      ]
                    },
                    "generator": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "external": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "class": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "none",
            "ollama",
            "claude-code",
            "anthropic",
            "exec"
          ]
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "timeout_seconds": {
          "type": "integer"
        },
        "max_concurrency": {
          "type": "integer"
        },
        "max_output_tokens": {
          "type": "integer"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_requests": {
              "type": "integer"
            },
            "max_usd": {
              "type": "number"
            },
            "max_tokens": {
              "type": "integer"
            }
          }
        },
        "claude_code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "program": {
              "type": "string"
            },
            "pass_env": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "program": {
              "type": "string"
            },
            "api_key_file": {
              "type": "string"
            },
            "api_key_env": {
              "type": "string"
            },
            "max_retries": {
              "type": "integer"
            },
            "fallbacks": {
              "type": "string",
              "enum": [
                "default",
                "none"
              ]
            }
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "seed": {
              "type": "integer"
            },
            "num_ctx": {
              "type": "integer"
            },
            "num_predict": {
              "type": "integer"
            },
            "retries": {
              "type": "integer"
            }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "local": {
              "type": "boolean"
            },
            "pass_env": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "snippet",
                  "agentic"
                ]
              }
            }
          }
        },
        "agentic": {
          "type": "object",
          "additionalProperties": false,
          "description": "Agentic mode of the judge (docsp audit/eval-model -mode agentic); 0 or empty = the default.",
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 0,
              "description": "tool steps of one per-line request (default 16)"
            },
            "drift_max_steps": {
              "type": "integer",
              "minimum": 0,
              "description": "tool steps of the repository drift scan (default 45)"
            },
            "max_request_usd": {
              "type": "number",
              "minimum": 0,
              "description": "cap of one per-line request (default 0.6); reaching it ends the request, not the run"
            },
            "drift_max_request_usd": {
              "type": "number",
              "minimum": 0,
              "description": "cap of the drift scan (default 2.5)"
            },
            "group": {
              "type": "string",
              "enum": [
                "line",
                "doc"
              ],
              "description": "line: one request per line (default, evaluated); doc: up to six lines of one document per request (cheaper)"
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "description": "effort of agentic requests; unset (default) = the model's own default, which the agentic design was evaluated with. ai.judge.effort applies to snippet mode only."
            }
          }
        }
      }
    }
  }
}
