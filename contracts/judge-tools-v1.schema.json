{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MIERAI/docs-platform/contracts/judge-tools-v1.schema.json",
  "title": "docs-platform/judge-tools/v1",
  "description": "Read-only tools an agentic judge may call. The CORE executes every call (never the provider), confined to the inspected worktree: paths are repository-relative, absolute paths, '..' segments and symlinks out of the tree are refused (os.Root); results are size-capped; git is limited to read-only sub-commands (log, show, blame, merge-base --is-ancestor) of validated revisions; any path segment named .git is refused (.github is an ordinary directory); private paths are refused for cloud providers (data classification). A provider writes one tool_call per line on stdout and reads one tool_result per line on stdin, then writes its judge/v1 response.",
  "oneOf_note": "a line is either a toolCall or a toolResult; validate against $defs",
  "type": "object",
  "$defs": {
    "toolCall": {
      "type": "object",
      "required": ["type", "id", "call", "tool", "args"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["tool_call"]},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$", "description": "the judge request id"},
        "call": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
        "tool": {"type": "string", "enum": ["list_dir", "read_file", "grep", "git_log", "git_show", "search", "glob", "git_changes", "changes_since", "find_references", "check_quote", "outline", "config_value"], "description": "1.1 adds search, glob, git_changes, changes_since, find_references and check_quote; 1.2 adds outline and config_value"},
        "args": {"type": "object"}
      }
    },
    "toolResult": {
      "type": "object",
      "required": ["type", "id", "call", "ok"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["tool_result"]},
        "id": {"type": "string"},
        "call": {"type": "string"},
        "ok": {"type": "boolean"},
        "content": {"description": "tool-specific result (see the *Result defs)"},
        "truncated": {"type": "boolean"},
        "error": {"type": "string", "maxLength": 500},
        "text": {"type": "string", "description": "1.2: the result rendered for a model (numbered file lines \"12: text\", \"path:line: text\" matches, no escaping); providers should show this, not content"}
      }
    },
    "listDirArgs": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string", "description": "'' or '.' = repository root"}}},
    "listDirResult": {"type": "object", "properties": {"entries": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "type": {"type": "string", "enum": ["file", "dir"]}, "size": {"type": "integer"}}}}}},
    "readFileArgs": {"type": "object", "required": ["path"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "from_line": {"type": "integer"}, "to_line": {"type": "integer"}}},
    "readFileResult": {"type": "object", "properties": {"path": {"type": "string"}, "from_line": {"type": "integer"}, "to_line": {"type": "integer"}, "total_lines": {"type": "integer"}, "lines": {"type": "array", "items": {"type": "string"}}}},
    "grepArgs": {"type": "object", "required": ["pattern"], "additionalProperties": false, "properties": {"pattern": {"type": "string", "description": "RE2 regular expression"}, "path": {"type": "string", "description": "file or directory prefix; '' = whole tree"}, "max_results": {"type": "integer"}}},
    "grepResult": {"type": "object", "properties": {"matches": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer"}, "text": {"type": "string"}}}}}},
    "gitLogArgs": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "max_count": {"type": "integer"}}},
    "gitLogResult": {"type": "object", "properties": {"commits": {"type": "array", "items": {"type": "object", "properties": {"sha": {"type": "string"}, "date": {"type": "string"}, "subject": {"type": "string"}}}}}},
    "gitShowArgs": {"type": "object", "required": ["rev"], "additionalProperties": false, "properties": {"rev": {"type": "string"}, "path": {"type": "string", "description": "with path: the file at rev (lines); without: the commit's message and diff"}}},
    "searchArgs": {"type": "object", "required": ["pattern"], "additionalProperties": false, "properties": {"pattern": {"type": "string", "description": "case-insensitive fixed string, or an RE2 expression (case-sensitive) with regex=true"}, "scope": {"type": "string", "description": "path glob ('*' = every tracked file; '*' also crosses '/', a glob without '/' also matches base names, a plain path matches the file or everything below the directory)"}, "regex": {"type": "boolean"}, "max_results": {"type": "integer"}}, "description": "1.1. The same search re-runs absence evidence: an absence is accepted only if this search finds nothing."},
    "searchResult": {"type": "object", "properties": {"matches": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer"}, "text": {"type": "string"}}}}, "files_searched": {"type": "integer"}}},
    "globArgs": {"type": "object", "required": ["pattern"], "additionalProperties": false, "properties": {"pattern": {"type": "string"}, "max_results": {"type": "integer"}}},
    "globResult": {"type": "object", "properties": {"paths": {"type": "array", "items": {"type": "string"}}}},
    "gitChangesArgs": {"type": "object", "additionalProperties": false, "properties": {"kind": {"type": "string", "description": "letters of A (added), D (deleted), R (renamed), M (modified); default DR"}, "path": {"type": "string"}, "max_count": {"type": "integer"}}},
    "gitChangesResult": {"type": "object", "properties": {"changes": {"type": "array", "items": {"type": "object", "properties": {"sha": {"type": "string"}, "date": {"type": "string"}, "subject": {"type": "string"}, "status": {"type": "string"}, "path": {"type": "string"}, "new_path": {"type": "string"}}}}}},
    "changesSinceArgs": {"type": "object", "required": ["path", "line"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "line": {"type": "integer"}}},
    "findReferencesArgs": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string"}}},
    "outlineArgs": {"type": "object", "required": ["path"], "additionalProperties": false, "properties": {"path": {"type": "string"}}, "description": "1.2"},
    "configValueArgs": {"type": "object", "required": ["key"], "additionalProperties": false, "properties": {"key": {"type": "string"}}, "description": "1.2"},
    "checkQuoteArgs": {"type": "object", "required": ["path", "line", "text"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "line": {"type": "integer"}, "text": {"type": "string"}}},
    "textResult": {"type": "object", "description": "changes_since, find_references and check_quote answer with a text report", "properties": {"text": {"type": "string"}}},
    "gitShowResult": {"type": "object", "properties": {"rev": {"type": "string"}, "path": {"type": "string"}, "lines": {"type": "array", "items": {"type": "string"}}, "text": {"type": "string"}}}
  }
}
