{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-platform/config/v1",
  "title": ".docsp.yaml - per-repository docs-platform configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [
        1
      ]
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_config": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_depth": {
      "type": "integer"
    },
    "min_confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "owner": {
      "type": "string"
    },
    "extractors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trailer": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "code",
              "docs"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "code": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "docs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "reverse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "related_repos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Layer 4(c) semantic audit (docsp audit).",
      "properties": {
        "stale_commits": {
          "type": "integer",
          "minimum": 1,
          "description": "later commits to a claim's code that make it stale (default 2)"
        },
        "skip": {
          "type": "object",
          "additionalProperties": false,
          "description": "Claims not put to the judge (each skip is counted by reason). Every field defaults to on.",
          "properties": {
            "historical": {
              "type": "boolean",
              "description": "sentences about the past: previously, used to, was deprecated, before vX, 以前, 曾经, 已废弃, 以前は, 廃止された (default true)"
            },
            "changelogs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "globs of changelog-type documents; without '/' a file name in any directory, case-insensitive (default: CHANGELOG*, CHANGES.md, HISTORY*, NEWS.md, release notes, docs/**/changelog*, docs/**/releases/**; [] = none)"
            },
            "tests": {
              "type": "boolean",
              "description": "comments in test files and claims that name only test files (default true)"
            },
            "private_symbols": {
              "type": "boolean",
              "description": "comments on unexported / private declarations and claims that name only such symbols (default true)"
            }
          }
        }
      }
    }
  }
}
